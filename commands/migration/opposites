#!/usr/bin/env bash

# DTM Migrations - create-opposites command
# Create Opposite References for DTM Assets

# import shared functions

# shellcheck source=/dev/null
source "$(dirname "$0")/../../shared/helper"
source "$(dirname "$0")/../../shared/constants"

# Stop on unexpected errors. Ensure that pipelines return the correct exit code.
set -eo pipefail

# Location of the shared jq programs and jsonnet templates
SHARED_DIR="$(cd "$(dirname "$0")/../../shared" && pwd)"
JQ_DIR="$SHARED_DIR/opposites/jq"
JSONNET_DIR="$SHARED_DIR/opposites/jsonnet"

# Help text
help() {
    cat <<EOF
Create Opposite references for DTM Assets with c8y_LinkedSeries fragment.

Usage:
    c8y dtm migration opposites [create|clear|verify|get] [args...]

Description:
    Creates or removes opposite references for all Assets that have the c8y_LinkedSeries fragment. 
    In create mode, for each linked series an opposite reference will be created as ChildAddition of the linked device.
    Create then verifies what it created and fails if any linked series is missing its opposite reference.
    In clear mode, all opposite references will be removed.
    In verify mode, opposite references are checked without changing them.
    In get mode, all opposite references are retrieved and displayed.

Flags:
    -h, --help             Show this help message
    --id                   Specify a single asset by ID or name to process opposite references for. Only used for verify mode.
    --includeParentDevice  Include parent device details in get mode output. Only used for get mode.
    --measurementGaps      For every link reported as MissingLinkedSeriesInChildAdditionError, report the
                           time range in which the device series holds measurements that the asset series
                           does not. Only used for verify mode. This reads measurement data and is more
                           expensive than the reference check, so it is opt-in.
                           By default this only compares the oldest/newest timestamp of both series (4
                           cheap requests per link), which is enough to bound a single trailing gap but
                           cannot see a gap that the asset series later recovered from, and cannot report
                           an exact missing-point count. Use --measurementGapsExact for that.
                           Note that measurements outside the tenant retention are already gone, so a
                           reported range is an upper bound of what could still be recovered.
    --measurementGapsExact Like --measurementGaps, but additionally reads every timestamp of both series
                           to report the exact missing points and to detect gaps the asset series later
                           recovered from. Orders of magnitude more expensive: up to two full,
                           possibly paginated series reads per link, on top of the 4 boundary requests.
                           Implies --measurementGaps.
    --outputFile FILE      Write output to FILE only if non-empty. Empty files are not created.
                           Only used for create/get/verify mode. For create it receives the
                           result of the verification that runs after the references are created.
    --stats                Print detailed statistics after verification (assets, links, devices,
                           reverse index entries, error breakdown). Only used for create/verify mode.
    --traceDir DIR         Write all intermediate verification data to DIR for troubleshooting.
                           Only used for create/verify mode.

Environment:
    C8Y_DTM_ABORT_ON_ERRORS   Errors tolerated per c8y call before it aborts (default 1000000)
    C8Y_DTM_MAX_ERROR_LINES   Error lines printed to the console (default 50)
    C8Y_DTM_GAPS_MAX_LINKS    Links probed by --measurementGaps/--measurementGapsExact (default 100,
                              0 = no limit). Links beyond the limit are reported with method 'skipped'.
    C8Y_DTM_GAPS_MAX_POINTS   Measurement timestamps read per series by --measurementGapsExact
                              (default 500000). Reaching it marks the link as truncated. Unused by
                              --measurementGaps, which never reads individual timestamps.

Examples:
    c8y dtm migration opposites create
    c8y dtm migration opposites create --stats --traceDir ./trace
    c8y dtm migration opposites clear
    c8y dtm migration opposites verify
    c8y dtm migration opposites verify --id "12345"
    c8y dtm migration opposites verify --id "My Asset Name"
    c8y dtm migration opposites get
    c8y dtm migration opposites get --includeParentDevice
    c8y dtm migration opposites get --outputFile "output.json"
    c8y dtm migration opposites verify --stats
    c8y dtm migration opposites verify --traceDir ./trace
    c8y dtm migration opposites verify --stats --outputFile "verification_result.json" --traceDir ./trace
    c8y dtm migration opposites verify --measurementGaps --stats
    c8y dtm migration opposites verify --id "12345" --measurementGapsExact --traceDir ./trace

Requirements:
    - go-c8y-cli authenticated session
    - jq for JSON processing
EOF
exit 0
}

# Default values
POSITIONAL_ARGS=()
MODE=""
ABORT_ON_ERRORS="${C8Y_DTM_ABORT_ON_ERRORS:-1000000}"

checkDefiningModeTwice() {
    if [ -n "$MODE" ]; then
        error "Bad args:" "Cannot specify more than one mode. Already set to '$MODE'."
        exit 1
    fi
}

checkModeIsSet() {
    if [ -z "$MODE" ]; then
        error "Bad args:" "No mode specified. Please specify either 'create', 'clear', 'verify' or 'get'."
        exit 1
    fi
}

checkAllowedSingleIdUsage() {
    if [ -z "$SINGLE_ID" ]; then
        return 0
    fi
    if [ "$MODE" != "verify" ]; then
        # Narrowing 'create' to a single asset would create opposite references for a
        # part of the tenant only, and the guard against existing child additions would
        # then block any later full run.
        error "Bad args:" "--id can only be used with 'verify' mode."
        exit 1
    fi
    info "Single asset mode enabled. Only the asset with id/name '$SINGLE_ID' will be verified."
}

checkGetFlagUsage() {
    if [ "$INCLUDE_PARENT_DEVICE" = "true" ] && [ "$MODE" != "get" ]; then
        error "Bad args:" "--includeParentDevice can only be used with 'get' mode."
        exit 1
    fi
    if [ -n "$SAFE_OUTPUT_FILE" ] && [ "$MODE" != "get" ] && [ "$MODE" != "verify" ] && [ "$MODE" != "create" ]; then
        error "Bad args:" "--outputFile can only be used with 'create', 'get' or 'verify' mode."
        exit 1
    fi
    if [ -n "$TRACE_DIR" ] && [ "$MODE" != "verify" ] && [ "$MODE" != "create" ]; then
        error "Bad args:" "--traceDir can only be used with 'create' or 'verify' mode."
        exit 1
    fi
    if [ "$SHOW_STATS" = "true" ] && [ "$MODE" != "verify" ] && [ "$MODE" != "create" ]; then
        error "Bad args:" "--stats can only be used with 'create' or 'verify' mode."
        exit 1
    fi
    if [ "$MEASUREMENT_GAPS" = "true" ] && [ "$MODE" != "verify" ]; then
        # Reading measurement data is orders of magnitude more expensive than the
        # reference check, so it is kept out of a migration run on purpose.
        error "Bad args:" "--measurementGaps/--measurementGapsExact can only be used with 'verify' mode."
        exit 1
    fi
}

SINGLE_ID=""
INCLUDE_PARENT_DEVICE="false"
SAFE_OUTPUT_FILE=""
TRACE_DIR=""
SHOW_STATS="false"
MEASUREMENT_GAPS="false"
MEASUREMENT_GAPS_EXACT="false"

# Parse arguments
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            help
            ;;
        --id)
            if [ -n "$SINGLE_ID" ]; then
                error "Bad args:" "Cannot specify --id more than once. Already set to '$SINGLE_ID'."
                exit 1
            fi
            if [ -z "${2:-}" ] || [[ "$2" == -* ]]; then
                error "Bad args:" "--id requires an ID argument."
                exit 1
            fi
            SINGLE_ID="$2"
            shift
            ;;
        --includeParentDevice)
            INCLUDE_PARENT_DEVICE="true"
            ;;
        --measurementGaps)
            MEASUREMENT_GAPS="true"
            ;;
        --measurementGapsExact)
            MEASUREMENT_GAPS="true"
            MEASUREMENT_GAPS_EXACT="true"
            ;;
        --outputFile)
            if [ -n "$SAFE_OUTPUT_FILE" ]; then
                error "Bad args:" "Cannot specify --outputFile more than once. Already set to '$SAFE_OUTPUT_FILE'."
                exit 1
            fi
            if [ -z "${2:-}" ] || [[ "$2" == -* ]]; then
                error "Bad args:" "--outputFile requires a FILE argument."
                exit 1
            fi
            SAFE_OUTPUT_FILE="$2"
            shift
            ;;
        --stats)
            SHOW_STATS="true"
            ;;
        --traceDir)
            if [ -n "$TRACE_DIR" ]; then
                error "Bad args:" "Cannot specify --traceDir more than once. Already set to '$TRACE_DIR'."
                exit 1
            fi
            if [ -z "${2:-}" ] || [[ "$2" == -* ]]; then
                error "Bad args:" "--traceDir requires a DIR argument."
                exit 1
            fi
            TRACE_DIR="$2"
            shift
            ;;
        create)
            checkDefiningModeTwice
            MODE="create"
            ;;
        clear)
            checkDefiningModeTwice
            MODE="clear"
            ;;
        verify)
            checkDefiningModeTwice
            MODE="verify"
            ;;
        get)
            checkDefiningModeTwice
            MODE="get"
            ;;
        *)
            POSITIONAL_ARGS+=("$1")
            ;;
    esac
    shift
done

# shellcheck disable=SC2034 # Used by validate_positional_args() from shared/helper.
ALLOWED_FLAGS=(
  --abortOnErrors --force -f --cache --cacheBodyPaths --cacheTTL --debug --delay --delayBefore --dry --filter --header -k --insecure -l --logMessage --maxJobs --noAccept -M --noColor --noCache -o --output --outputFileRaw --progress --select --timeout --totalErrors --workers --verbose --raw
)

checkModeIsSet
checkAllowedSingleIdUsage
checkGetFlagUsage

# Restore additional arguments
set -- "${POSITIONAL_ARGS[@]}"

validate_positional_args "$@"

check_prerequisites

if [ ! -d "$JQ_DIR" ] || [ ! -d "$JSONNET_DIR" ]; then
    error "Incomplete installation." "Expected the shared jq programs in '$JQ_DIR' and the jsonnet templates in '$JSONNET_DIR'."
    exit 1
fi

# Maximum number of individual error lines printed to the console. The full list is
# always available via --outputFile / --traceDir.
MAX_ERROR_LINES="${C8Y_DTM_MAX_ERROR_LINES:-50}"

# Guard rails for --measurementGaps. Every probed link costs four boundary requests
# plus a full read of the timestamps of one or two series, so both the number of
# links and the number of timestamps per series are capped by default.
GAPS_MAX_LINKS="${C8Y_DTM_GAPS_MAX_LINKS:-100}"
GAPS_MAX_POINTS="${C8Y_DTM_GAPS_MAX_POINTS:-500000}"
if ! [[ "$GAPS_MAX_LINKS" =~ ^[0-9]+$ ]]; then
    error "Bad environment:" "C8Y_DTM_GAPS_MAX_LINKS must be a non-negative integer, got '$GAPS_MAX_LINKS'."
    exit 1
fi
if ! [[ "$GAPS_MAX_POINTS" =~ ^[0-9]+$ ]] || [ "$GAPS_MAX_POINTS" -lt 1 ]; then
    error "Bad environment:" "C8Y_DTM_GAPS_MAX_POINTS must be a positive integer, got '$GAPS_MAX_POINTS'."
    exit 1
fi

if [ -n "$TRACE_DIR" ]; then
    mkdir -p "$TRACE_DIR"
    info "Trace enabled. Intermediate data will be written to '$TRACE_DIR'."
fi

# Write intermediate data to the trace directory when --traceDir is set.
# Usage: trace_write <file-name> <content>
trace_write() {
    [ -n "$TRACE_DIR" ] || return 0
    local file="$TRACE_DIR/$1"
    local content="$2"
    if [ -z "$content" ]; then
        : > "$file"
    else
        printf '%s\n' "$content" > "$file"
    fi
    info "Trace: $file ($(count_lines "$content") lines)"
}

if [ -n "$SINGLE_ID" ]; then
    export FILTER_QUERY="(id eq '$SINGLE_ID' or name eq '$SINGLE_ID') and has(${LINKED_SERIES_FRAGMENT})"
else
    export FILTER_QUERY="hasany(${LINKED_SERIES_FRAGMENT}.source.id)"
fi
export EXTRA_SELECT_FIELDS="${LINKED_SERIES_FRAGMENT}"

load_assets_with_linked_series() {
    assets_with_linked_series=$(load_all_assets)

    if is_empty_result_set "$assets_with_linked_series" ; then
        info "No assets with linked series found. Exiting."
        return 1
    fi

    total_collected=$(count_lines "$assets_with_linked_series")
    info "Found $total_collected assets with linked series. Processing..."
    
    echo "$assets_with_linked_series"
}

explode_assets_with_linked_series() {
    explodedSeries=$(
      echo "$assets_with_linked_series" | jq -c -f "$JQ_DIR/explode-linked-series.jq"
    )
    echo "$explodedSeries"
}

plural_devices() {
    if [ "$1" = "1" ]; then echo "device"; else echo "devices"; fi
}

# Computes verification statistics as a single JSON object.
# Usage: build_verification_statistics <assets-file> <links-file> <devices-file> <result-file>
build_verification_statistics() {
    jq -n \
        --slurpfile assets "$1" \
        --slurpfile links "$2" \
        --slurpfile devices "$3" \
        --slurpfile result "$4" \
        -f "$JQ_DIR/verification-statistics.jq"
}

# Renders the statistics JSON as an aligned text block on stderr.
# Usage: render_verification_statistics <statistics-json>
render_verification_statistics() {
    printf '%s\n' "$1" | jq -r -f "$JQ_DIR/render-statistics.jq" >&2
}

# Reads all measurement timestamps of one series into a file, capped at
# C8Y_DTM_GAPS_MAX_POINTS. --nullInput is required because --device accepts pipeline
# input and would otherwise swallow the stdin of the calling loop.
#
# fragment and series must be passed percent-encoded. go-c8y-cli decodes the value of
# a query flag once before it builds the request, and Go's query parser rejects a
# literal ';' as it appears in every OPC UA node id such as "ns=2;s=Machine/Temp". An
# unencoded value makes go-c8y-cli drop --valueFragmentSeries silently, and the call
# would then return the measurements of every series of the fragment. Verify with:
#   c8y measurements list --device 1 --valueFragmentSeries "$(jq -rn --arg s "$s" '$s|@uri')" \
#       --dry --dryFormat json | jq -r .query
# The url of `c8y api` is decoded twice instead, see gap-bound-requests.jq.
#
# Usage: enumerate_series_times <source-id> <fragment-uri> <series-uri> <out-file>
# Sets GAP_TRUNCATED and GAP_FAILED as the return channel for the caller.
enumerate_series_times() {
    local source_id="$1" fragment="$2" series="$3" out_file="$4"
    local read_count
    local -a status
    GAP_TRUNCATED="false"
    GAP_FAILED="false"

    # head stops the paging of --includeAll once the cap is reached, one line beyond
    # the cap is read to tell a complete series from a truncated one.
    set +e
    c8y measurements list \
        --device "$source_id" \
        --valueFragmentType "$fragment" \
        --valueFragmentSeries "$series" \
        --dateFrom "$GAPS_DATE_FROM" \
        --dateTo "$GAPS_DATE_TO" \
        --revert=false \
        --includeAll \
        --select time \
        --nullInput \
        "${C8Y_FLAGS[@]}" 2>>"$GAPS_WORK_DIR/gap-measurements-stderr.log" \
      | head -n "$((GAPS_MAX_POINTS + 1))" > "$out_file"
    status=("${PIPESTATUS[@]}")
    set -e

    read_count=$(wc -l < "$out_file" | tr -d ' \n\r\t')
    if [ "$read_count" -gt "$GAPS_MAX_POINTS" ]; then
        GAP_TRUNCATED="true"
        head -n "$GAPS_MAX_POINTS" "$out_file" > "$out_file.part"
        mv "$out_file.part" "$out_file"
    elif [ "${status[0]}" -ne 0 ] && [ "${status[0]}" -ne 141 ]; then
        # 141 is SIGPIPE, which only happens when head closed the stream on the cap
        GAP_FAILED="true"
    fi
}

# Determines, for every link reported as MissingLinkedSeriesInChildAdditionError, the
# time ranges in which the source device holds measurements for source.fragment /
# source.series that the asset does not hold for its own fragment / series.
#
# Stage 1 asks for the oldest and the newest measurement of both sides in a single
# batched fan-out. That classifies every link and, for the common case of an asset
# series that never received anything, already bounds the gap. Stage 2 then reads the
# individual timestamps, of the device only when the asset series is empty, and of
# both sides when they have to be compared one by one.
#
# Usage: compute_measurement_gaps <error-items> <work-dir>
# Writes one gap record per missing link to stdout.
compute_measurement_gaps() {
    local error_items="$1"
    GAPS_WORK_DIR="$2"

    local plan plan_count probe_count requests probes request_count response_count
    plan=$(printf '%s\n' "$error_items" | jq -c -s --argjson maxLinks "$GAPS_MAX_LINKS" -f "$JQ_DIR/gap-plan.jq")
    if is_empty_result_set "$plan"; then
        info "No missing links found, no measurement gaps to determine."
        return 0
    fi

    printf '%s\n' "$plan" > "$GAPS_WORK_DIR/gap-plan.json"
    plan_count=$(count_lines "$plan")
    probe_count=$(jq -s '[.[] | select(.probe)] | length' "$GAPS_WORK_DIR/gap-plan.json")

    if [ "$probe_count" -lt "$plan_count" ]; then
        warn "Measurement gaps are only determined for $probe_count of $plan_count missing links." \
             "Raise C8Y_DTM_GAPS_MAX_LINKS to cover more, the remaining links are reported with method 'skipped'."
    fi
    info "Determining measurement gaps for $probe_count of $plan_count missing links..."

    # An explicit window is required: revert needs one, and the default sort order of
    # the measurement API differs between the classic and the time series store.
    GAPS_DATE_FROM="1970-01-01T00:00:00.000Z"
    GAPS_DATE_TO=$(date -u +%Y-%m-%dT%H:%M:%S.000Z)

    requests=$(jq -c --arg dateFrom "$GAPS_DATE_FROM" --arg dateTo "$GAPS_DATE_TO" \
        -f "$JQ_DIR/gap-bound-requests.jq" "$GAPS_WORK_DIR/gap-plan.json")
    trace_write "verify-measurement-gap-requests.json" "$requests"

    # c8y api maps the url property of a piped object onto its --url flag, so the
    # probe stays correlated with its link through input.value.
    set +e
    probes=$(
      printf '%s\n' "$requests" |
      c8y api --method GET \
          --withError \
          --abortOnErrors "$ABORT_ON_ERRORS" \
          --outputTemplate 'input.value + { response: output }' \
          "${C8Y_FLAGS[@]}" 2>"$GAPS_WORK_DIR/gap-probe-stderr.log"
    )
    set -e
    printf '%s\n' "$probes" > "$GAPS_WORK_DIR/gap-probes.json"

    request_count=$(count_lines "$requests")
    response_count=$(count_lines "$probes")
    if [ "$response_count" -ne "$request_count" ]; then
        warn "Incomplete measurement boundary probes. Sent $request_count requests but received $response_count responses." \
             "The affected links are reported with method 'probeFailed'."
        if [ -s "$GAPS_WORK_DIR/gap-probe-stderr.log" ]; then
            tail -n 10 "$GAPS_WORK_DIR/gap-probe-stderr.log" >&2
        fi
    fi

    jq -c -n \
        --slurpfile plan "$GAPS_WORK_DIR/gap-plan.json" \
        --slurpfile probes "$GAPS_WORK_DIR/gap-probes.json" \
        -f "$JQ_DIR/gap-bounds.jq" > "$GAPS_WORK_DIR/gap-bounds.json"
    trace_write "verify-measurement-gap-bounds.json" "$(cat "$GAPS_WORK_DIR/gap-bounds.json")"

    local records="$GAPS_WORK_DIR/gap-records.json"
    local points="$GAPS_WORK_DIR/gap-points.json"
    : > "$records"
    : > "$points"

    if [ "$MEASUREMENT_GAPS_EXACT" != "true" ]; then
        # Boundary-only estimate: device.first/last and asset.first/last from the probe
        # above are all gap-diff-fast.jq needs, so no further measurement query runs.
        info "Estimating gaps from series boundaries only. Use --measurementGapsExact for exact point counts."
        jq -c -f "$JQ_DIR/gap-diff-fast.jq" "$GAPS_WORK_DIR/gap-bounds.json" | jq -c 'del(.missingTimes)' >> "$records"
        cat "$records"
        return 0
    fi

    local device_times="$GAPS_WORK_DIR/gap-device-times.json"
    local asset_times="$GAPS_WORK_DIR/gap-asset-times.json"
    local current="$GAPS_WORK_DIR/gap-current.json"

    local bound_rec method probe_state
    while IFS= read -r bound_rec; do
        [ -n "$bound_rec" ] || continue
        method=$(printf '%s' "$bound_rec" | jq -r '.method')
        : > "$device_times"
        : > "$asset_times"
        local device_truncated="false" device_failed="false"
        local asset_truncated="false" asset_failed="false"

        if [ "$method" = "assetEmpty" ] || [ "$method" = "timestampDiff" ]; then
            enumerate_series_times \
                "$(printf '%s' "$bound_rec" | jq -r '.sourceId')" \
                "$(printf '%s' "$bound_rec" | jq -r '.sourceFragment | @uri')" \
                "$(printf '%s' "$bound_rec" | jq -r '.sourceSeries | @uri')" \
                "$device_times"
            device_truncated="$GAP_TRUNCATED"
            device_failed="$GAP_FAILED"
        fi
        if [ "$method" = "timestampDiff" ]; then
            enumerate_series_times \
                "$(printf '%s' "$bound_rec" | jq -r '.assetId')" \
                "$(printf '%s' "$bound_rec" | jq -r '.fragment | @uri')" \
                "$(printf '%s' "$bound_rec" | jq -r '.series | @uri')" \
                "$asset_times"
            asset_truncated="$GAP_TRUNCATED"
            asset_failed="$GAP_FAILED"
        fi

        probe_state=$(jq -c -n \
            --argjson deviceTruncated "$device_truncated" --argjson deviceFailed "$device_failed" \
            --argjson assetTruncated "$asset_truncated" --argjson assetFailed "$asset_failed" \
            '{ device: { truncated: $deviceTruncated, failed: $deviceFailed },
               asset:  { truncated: $assetTruncated,  failed: $assetFailed } }')

        # The exact timestamps can be a very large array, so the record is kept in a
        # file and split from there instead of being carried in a shell variable.
        jq -c -n \
            --argjson bounds "$bound_rec" \
            --argjson probe "$probe_state" \
            --slurpfile deviceTimes "$device_times" \
            --slurpfile assetTimes "$asset_times" \
            -f "$JQ_DIR/gap-diff.jq" > "$current"

        jq -c 'del(.missingTimes)' "$current" >> "$records"
        jq -c 'select((.missingTimes | length) > 0)
               | { key, assetId, fragment, series, sourceId, sourceFragment, sourceSeries, times: .missingTimes }' \
            "$current" >> "$points"
    done < "$GAPS_WORK_DIR/gap-bounds.json"

    if [ -n "$TRACE_DIR" ]; then
        cp "$points" "$TRACE_DIR/verify-measurement-gap-points.json"
        info "Trace: $TRACE_DIR/verify-measurement-gap-points.json ($(wc -l < "$points" | tr -d ' \n\r\t') lines)"
        if [ -s "$GAPS_WORK_DIR/gap-measurements-stderr.log" ]; then
            cp "$GAPS_WORK_DIR/gap-measurements-stderr.log" "$TRACE_DIR/verify-measurement-gap-stderr.log"
            info "Trace: $TRACE_DIR/verify-measurement-gap-stderr.log"
        fi
    fi

    cat "$records"
}

# Verifies that every (asset, linked series) pair has a matching entry in the
# c8y_LinkedSeriesReverseIndex child addition of its source device.
#
# Each source device is queried only once, but ALL links pointing to it are checked
# against the child addition that is returned. A link is identified by the asset side
# of the stored entry (asset.id + asset.fragment + asset.series), because that is its
# only unique identity. The source fragment/series alone is ambiguous: many assets and
# series can share the same source fragment and series on one device.
run_verification() {
    info "Running verification..."

    assets_with_linked_series=$(load_assets_with_linked_series) || return 0
    trace_write "verify-assets.json" "$assets_with_linked_series"

    # One record per (asset, linked series) pair. "id" is the source device id.
    explodedSeries=$(
      explode_assets_with_linked_series \
        | jq -c -f "$JQ_DIR/link-records.jq"
    )

    if is_empty_result_set "$explodedSeries"; then
        info "No linked series with a source device found. Nothing to verify."
        return 0
    fi

    total_collected=$(count_lines "$explodedSeries")
    info "Found $total_collected links to verify."
    trace_write "verify-explodedSeries.json" "$explodedSeries"

    # Query each source device only once. The links themselves are not piped to c8y,
    # they are matched locally afterwards.
    uniqueDevices=$(echo "$explodedSeries" | jq -cs 'map({id: .id}) | unique | .[]')
    unique_count=$(count_lines "$uniqueDevices")
    trace_write "verify-uniqueDevices.json" "$uniqueDevices"

    info "Found $unique_count unique source devices. Verifying all $total_collected links against them..."


    local work_dir
    work_dir=$(mktemp -d)
    # shellcheck disable=SC2064 # expand work_dir now, not when the trap runs
    trap "rm -rf '$work_dir'" RETURN

    # Temporarily disable exit on error to allow processing to continue
    set +e
    childAdditionsByDevice=$(
      echo "$uniqueDevices" |
      c8y inventory children list \
          --childType addition \
          --withError \
          --abortOnErrors "$ABORT_ON_ERRORS" \
          --query "type eq c8y_LinkedSeriesReverseIndex" \
          --raw \
          --outputTemplate "$JSONNET_DIR/verify-child-addition.jsonnet" \
          "${C8Y_FLAGS[@]}" 2>"$work_dir/c8y-stderr.log"
    )
    list_exit_code=$?
    set -e

    trace_write "verify-childAdditions.json" "$childAdditionsByDevice"
    if [ -n "$TRACE_DIR" ]; then
        cp "$work_dir/c8y-stderr.log" "$TRACE_DIR/verify-c8y-stderr.log"
        info "Trace: $TRACE_DIR/verify-c8y-stderr.log"
    fi

    local response_count
    response_count=$(count_lines "$childAdditionsByDevice")

    if [ "$list_exit_code" -ne 0 ] && [ "$response_count" -eq 0 ]; then
        error "Verification failed." "Failed to load child additions (command failed or was aborted)."
        if [ -s "$work_dir/c8y-stderr.log" ]; then
            tail -n 20 "$work_dir/c8y-stderr.log" >&2
        fi
        return 1
    fi

    if [ "$response_count" -ne "$unique_count" ]; then
        warn "Incomplete verification data. Queried $unique_count devices but received $response_count records." \
             "$((unique_count - response_count)) device(s) returned nothing (aborted request or output template error). Those links are reported as NoVerificationResultError."
        if [ -s "$work_dir/c8y-stderr.log" ]; then
            tail -n 10 "$work_dir/c8y-stderr.log" >&2
        fi
    fi

    # Match every single link against the c8y_LinkedAssets of its source device.
    printf '%s\n' "$assets_with_linked_series" > "$work_dir/assets.json"
    printf '%s\n' "$explodedSeries" > "$work_dir/links.json"
    printf '%s\n' "$childAdditionsByDevice" > "$work_dir/devices.json"

    result=$(
      jq -c -n \
        --slurpfile devices "$work_dir/devices.json" \
        --slurpfile links "$work_dir/links.json" \
        -f "$JQ_DIR/verify-match-links.jq"
    )

    error_items=$(echo "$result" | jq -c 'select(.error != null)')

    # Enrich the missing links with the measurement gap they caused before anything
    # else consumes the result, so the output file, the console error lines and the
    # statistics all report the same records.
    local gap_statistics=""
    if [ "$MEASUREMENT_GAPS" = "true" ]; then
        local gap_records
        gap_records=$(compute_measurement_gaps "$error_items" "$work_dir")
        trace_write "verify-measurement-gaps.json" "$gap_records"
        if is_not_empty_result_set "$gap_records"; then
            printf '%s\n' "$gap_records" > "$work_dir/gaps.json"
            result=$(printf '%s\n' "$result" | jq -c --slurpfile gaps "$work_dir/gaps.json" -f "$JQ_DIR/gap-attach.jq")
            error_items=$(echo "$result" | jq -c 'select(.error != null)')
            gap_statistics=$(jq -c -s -f "$JQ_DIR/gap-statistics.jq" "$work_dir/gaps.json")
        fi
    fi

    printf '%s\n' "$result" > "$work_dir/result.json"
    trace_write "verify-result.json" "$result"
    trace_write "verify-errors.json" "$error_items"

    # The statistics object is the single source of truth for all verification counts,
    # both for the verdict below and for the optional --stats output.
    local statistics devices_with_errors links_checked links_failed series_reconcile
    local links_missing links_unverifiable
    statistics=$(build_verification_statistics \
        "$work_dir/assets.json" "$work_dir/links.json" \
        "$work_dir/devices.json" "$work_dir/result.json")

    # Merged as a separate section so that the invariant of verification-statistics.jq
    # stays untouched when --measurementGaps is not used.
    if [ -n "$gap_statistics" ]; then
        statistics=$(printf '%s\n%s\n' "$statistics" "$gap_statistics" | jq -c -s 'add')
    fi
    trace_write "verify-statistics.json" "$statistics"

    IFS=$'\t' read -r links_checked links_missing links_unverifiable devices_with_errors series_reconcile < <(
        printf '%s\n' "$statistics" \
          | jq -r '[.links.verified,
                    .links.missing,
                    .links.unverifiable,
                    .devices.withErrors,
                    (.assets.linkedSeriesWithSource + .assets.linkedSeriesWithoutSource == .assets.linkedSeriesDefined)] | @tsv'
    )
    links_failed=$((links_missing + links_unverifiable))

    if [ "$series_reconcile" != "true" ]; then
        warn "Linked series accounting mismatch." "The sourced and unsourced linked series do not add up to the number defined on the assets. Statistics are unreliable, see verify-statistics.json."
    fi

    if [ -n "$SAFE_OUTPUT_FILE" ] || has_flag "--output" || has_flag "-o" || has_flag "--outputFileRaw" || has_flag "--raw"; then
        if [ -n "$SAFE_OUTPUT_FILE" ]; then
            resultCount=$(count_lines "$result")
            if [ "$resultCount" -gt 0 ]; then
                echo "$result" | c8y util show "${C8Y_FLAGS[@]}" > "$SAFE_OUTPUT_FILE"
            fi
        else
            # Output to stdout
            echo "$result" | c8y util show "${C8Y_FLAGS[@]}"
        fi
    fi

    local printed=0
    while IFS=$'\t' read -r err_type err_msg; do
        if [ -z "$err_type" ]; then continue; fi
        if [ "$printed" -ge "$MAX_ERROR_LINES" ]; then
            printed=$((printed+1))
            continue
        fi
        printed=$((printed+1))
        error "$err_type" "$err_msg"
    done < <(echo "$error_items" | jq -r -s -f "$JQ_DIR/verification-error-messages.jq")

    if [ "$printed" -gt "$MAX_ERROR_LINES" ]; then
        warn "$((printed - MAX_ERROR_LINES)) further error lines suppressed." \
             "Use --outputFile or --traceDir to get the complete list, or raise C8Y_DTM_MAX_ERROR_LINES."
    fi

    if [ "$SHOW_STATS" = "true" ]; then
        render_verification_statistics "$statistics"
    fi

    if [ "$((links_checked + links_failed))" -ne "$total_collected" ]; then
        warn "Link accounting mismatch." "$total_collected links found, but $links_checked verified and $links_failed reported as failing."
    fi

    if [ "$devices_with_errors" -gt 0 ]; then
        message="Checked $total_collected sourced linked series of $(count_lines "$assets_with_linked_series") assets on $unique_count devices:"
        message="$message $links_missing missing and $links_unverifiable unverifiable, on $devices_with_errors $(plural_devices "$devices_with_errors")."
        error "Verification errors." "$message"
        return 1
    fi

    success "Verification completed successfully." "All $links_checked sourced linked series of $(count_lines "$assets_with_linked_series") assets on $unique_count devices have opposite references."
    return 0
}

if [ "$MODE" = "create" ]; then
    info "Started creating opposite reference..."

    existing_childaddtions=$(c8y inventory find --pageSize 1 --type "c8y_LinkedSeriesReverseIndex")
    if ! is_empty_result_set "$existing_childaddtions"; then
        error "Existing child additions detected." "There are already opposite references in the tenant. Stopping."
        exit 1
    fi

    assets_with_linked_series=$(load_assets_with_linked_series) || exit 0

    # Get only the data we need for the next steps, and simplify the structure for easier processing
    explodedSeries=$(explode_assets_with_linked_series)
    total_collected=$(count_lines "$explodedSeries")

    info "Found $total_collected links to create opposite references."

    childAdditions=$(
      printf '%s' "$explodedSeries" \
        | jq -c -s -f "$JQ_DIR/build-child-additions.jq"
    )

    trace_write "create-childAdditions.json" "$childAdditions"

    # Source devices might not exist, filter non-existing devices by checking before creating child additions
    # to avoid creating child additions with missing source references. This would happen, as 
    # c8y devices children create --childType "addition" creates the object first and fails only when 
    # assigning the new managed object to the source device as a child addition keeping stale managed objects.
    filteredList=$(
      echo "$childAdditions" | c8y inventory assert exists --attempts 1 --workers 20
    )

    trace_write "create-filteredList.json" "$filteredList"

    missing_count=$(($(count_lines "$childAdditions") - $(count_lines "$filteredList")))
    existing_count=$(count_lines "$filteredList")
    if [ "$missing_count" -gt 0 ]; then
        warn "Filtered $missing_count non-existing source devices." "Opposites will be created for $existing_count devices."
    fi

    echo "$filteredList" | c8y devices children create \
        --childType "addition" \
        --template '{ c8y_LinkedAssets: input.value.c8y_LinkedAssets, type: "c8y_LinkedSeriesReverseIndex" }' \
        "${C8Y_FLAGS[@]}"

    # Alternative: let the platform create the references via the opposite endpoint
    # echo "$explodedSeries" | jq -r '"/assets/" + .id + "/linkedSeries/" + .c8y_LinkedSeries.fragment + "/" + .c8y_LinkedSeries.series + "/opposite"' | c8y api --method PUT --url "%s" "${C8Y_FLAGS[@]}"

    if run_verification; then
        exit 0
    fi
    exit 1
elif [ "$MODE" = "verify" ]; then
    if run_verification; then
        exit 0
    fi
    exit 1
elif [ "$MODE" = "clear" ]; then
    info "Clearing opposite references..."
    c8y inventory find --includeAll --type "c8y_LinkedSeriesReverseIndex" | c8y inventory delete "${C8Y_FLAGS[@]}"
elif [ "$MODE" = "get" ]; then
    info "Retrieving opposite references..."

    child_additions=$(
        c8y inventory list \
            --type "c8y_LinkedSeriesReverseIndex" \
            --includeAll \
            --output json
    )

    existing_count=$(count_lines "$child_additions")
    if [ "$existing_count" -eq 0 ]; then
        info "No opposite references found."
        exit 0
    fi

    info "Found $existing_count opposite references."

    # Prepare output 
    if [ "$INCLUDE_PARENT_DEVICE" = "true" ]; then
        output=$(
            echo "$child_additions" \
                | c8y inventory parents get --type addition --workers 10 --output json --outputTemplate '
                    input.value + { "parentDevice": output }
                ' \
                | c8y util show "${C8Y_FLAGS[@]}"
        )
    else
        output=$(echo "$child_additions" | c8y util show "${C8Y_FLAGS[@]}")
    fi

    # Write output (to file if specified, otherwise to stdout)
    if [ -n "$SAFE_OUTPUT_FILE" ]; then
        resultCount=$(count_lines "$output")
        if [ "$resultCount" -eq 0 ]; then
            info "Output is empty. No file will be created."
            exit 0
        fi
        echo "Writing output to file '$SAFE_OUTPUT_FILE'..."
        echo "$output" > "$SAFE_OUTPUT_FILE"
    else
        # Output to stdout
        echo "$output"
    fi
fi